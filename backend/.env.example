PORT=1337
NODE_ENV=development

MONGO_URL=mongodb://localhost:27017/bimd_template

JWT_SECRET=change-me-use-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_BASE_URL=http://localhost:5173
# Lista separada por vírgula. O dev server do Vite roda com `server.host:
# true` (frontend/vite.config.ts), então também fica acessível pelos IPs
# de rede da máquina (LAN, adaptador WSL/Docker Desktop) — usado no teste
# multi-brand local (ver frontend/src/branding/resolveTenantKey.ts,
# DEV_HOST_BRAND_KEYS). Esses IPs mudam ao reiniciar a máquina/rede; se
# mudarem, atualize a lista aqui e o mapa em resolveTenantKey.ts.
CORS_ORIGINS=http://localhost:5173,http://192.168.1.14:5173,http://172.19.128.1:5173

INITIAL_USER_EMAIL=admin@bimd.local
INITIAL_USER_PASSWORD=ChangeMe123!
INITIAL_USER_NAME=Administrador

EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

EMAIL_ENABLED=true
EMAIL_FROM=no-reply@bimd.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bimd-template
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRES_IN=900
